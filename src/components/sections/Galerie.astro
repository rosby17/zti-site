---
// Galerie de photos : grille d'images avec légende, agrandies d'un clic (visionneuse du site).
import Cadre from './Cadre.astro';
import { lien } from '../../lib/contenu';
const { s, premier = false } = Astro.props as { s: any; premier?: boolean };
const images = (s.images || []).filter((x: any) => x.image);
---
<Cadre premier={premier} s={s} defaut="blanc">
  <div class={`galerie n${images.length}`}>
    {images.map((x: any) => (
      <figure class="rv">
        <button type="button" data-visionneuse={lien(x.image)} aria-label={`Agrandir : ${x.legende || 'photo'}`}>
          <img src={lien(x.image)} alt={x.legende || ''} loading="lazy">
        </button>
        {x.legende && <figcaption>{x.legende}</figcaption>}
      </figure>
    ))}
  </div>
  {s.mention && <p class="mention" style="margin-top:16px">{s.mention}</p>}
</Cadre>
