---
import Cadre from './Cadre.astro';
import { references, lien } from '../../lib/contenu';
const { s, premier = false } = Astro.props as { s: any; premier?: boolean };
const liste = await references();
---
{liste.length > 0 && (
  <Cadre premier={premier} s={s} defaut="ivoire" id={s.ancre || 'references'} centre>
    <div class="defile">
      <ul class="logos">
        {liste.map(r => <li><img src={lien(r.logo)} alt="" loading="lazy">{r.nom}</li>)}
      </ul>
      <ul class="logos" aria-hidden="true">
        {liste.map(r => <li><img src={lien(r.logo)} alt="" loading="lazy">{r.nom}</li>)}
      </ul>
    </div>
  </Cadre>
)}
