---
import Icone from './Icone.astro';
import { reglages, services, lien, iconeReseau, lienSur } from '../lib/contenu';
const { sansMenu = false } = Astro.props as { sansMenu?: boolean };
const r = await reglages();
const liste = await services();
const reseaux = (r.reseaux || []).map(x => ({ ...x, adresse: lienSur(x.adresse) })).filter(x => x.nom && x.adresse);
// icônes « Suivez ZTi » : les réseaux des réglages, puis WhatsApp
const icone = (nom: string) => iconeReseau(nom) as any;
const suivre = [
  ...reseaux.map(x => ({ nom: x.nom, adresse: x.adresse, icone: icone(x.nom) })),
  // WhatsApp : la communauté « Parlons de vos problèmes IT » si elle existe, sinon la discussion avec ZTi
  ...(!reseaux.some(x => icone(x.nom) === 'whatsapp') && (lienSur(r.communaute?.whatsapp) || r.contact.whatsapp)
    ? [{ nom: lienSur(r.communaute?.whatsapp) ? 'Communauté WhatsApp' : 'WhatsApp', adresse: lienSur(r.communaute?.whatsapp) || `https://wa.me/${r.contact.whatsapp.replace(/\D/g, '')}`, icone: 'whatsapp' as any }] : []),
];
const annee = new Date().getFullYear();
const serveur = (r.mesures?.endpoint || '').trim().replace(/\/$/, '');
---
<footer class="pied">
  <div class="contenu">
    <div class="colonnes">
      <div class="marque">
        <img src={lien('/images/logo-blanc.png')} alt={r.nom} width="68" height="44" loading="lazy">
        <p>{r.signature}<br>Depuis {r.depuis}</p>
        <p>« {r.slogan} »</p>
        {suivre.length > 0 && (
          <div class="suivre">
            <span>Suivez ZTi</span>
            <ul>{suivre.map(x => <li><a href={x.adresse} rel="noopener" target="_blank" aria-label={`ZTi sur ${x.nom}`}><Icone nom={x.icone} /></a></li>)}</ul>
          </div>
        )}
      </div>
      <div>
        <h4>Nos services</h4>
        <ul>{liste.map(s => <li><a href={lien(`/services/${s.id}/`)}>{s.data.titre}</a></li>)}</ul>
      </div>
      <div>
        <h4>ZTi</h4>
        <ul>
          {!sansMenu && r.menu.map(m => <li><a href={lien(m.lien)}>{m.texte}</a></li>)}
          {sansMenu && <li><a href={lien('/')}>Découvrir ZTi</a></li>}
          <li><a href={lien('/#avis')}>Donner votre avis</a></li>
          <li><a href={lien('/telechargements/')}>Téléchargements</a></li>
          {serveur && <li><a href={serveur + '/espace/'}>Espace ambassadeurs</a></li>}
        </ul>
      </div>
      <div>
        <h4>Support</h4>
        <ul>
          {r.contact.email && <li><a href={`mailto:${r.contact.email}`}>{r.contact.email}</a></li>}
          {r.contact.adresse && <li>{r.contact.adresse}</li>}
          {r.contact.horaires && <li>{r.contact.horaires}</li>}
        </ul>
      </div>
    </div>
    <div class="geant" aria-hidden="true" style={`--logo-zti: url(${lien('/images/logo-zti.svg')})`}></div>
    <div class="bas">
      <span>© {annee} {r.nom_legal}. Tous droits réservés.</span>
      <a href={lien('/confidentialite/')}>Politique de confidentialité</a>
    </div>
  </div>
</footer>
