---
// Gabarit commun de toutes les pages : en-tête, pied de page, aperçu des liens (Facebook, WhatsApp), pixel Meta.
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/zti.css';
import '../styles/retouches.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import SuivezNous from '../components/SuivezNous.astro';
import { reglages, lien } from '../lib/contenu';

interface Props { titre: string; description?: string; image?: string; sansMenu?: boolean; indexer?: boolean }
const { titre, description, image, sansMenu = false, indexer = true } = Astro.props;
const r = await reglages();
const titreComplet = titre === r.nom ? `${r.nom} — ${r.slogan}` : `${titre} — ${r.nom}`;
const desc = description || r.description;
const adresse = new URL(Astro.url.pathname, Astro.site).href;
const apercu = new URL(lien(image || '/images/partage.jpg'), Astro.site).href;
const pixel = (r.mesures?.pixel || '').trim();
const serveur = (r.mesures?.endpoint || '').trim().replace(/\/$/, '');
---
<!doctype html>
<html lang="fr" class="sans-js" data-serveur={serveur}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titreComplet}</title>
  <meta name="description" content={desc}>
  {!indexer && <meta name="robots" content="noindex">}
  <link rel="canonical" href={adresse}>
  <link rel="icon" href={lien('/favicon.ico')} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={lien('/favicon-32.png')}>
  <link rel="apple-touch-icon" href={lien('/apple-touch-icon.png')}>
  <link rel="manifest" href={lien('/site.webmanifest')}>
  <meta name="theme-color" content="#010038">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content={r.nom}>
  <meta property="og:title" content={titreComplet}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={adresse}>
  <meta property="og:image" content={apercu}>
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>document.documentElement.classList.remove('sans-js');</script>
  {pixel && (
    <script is:inline define:vars={{ pixel }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixel); fbq('track', 'PageView');
    </script>
  )}
</head>
<body>
  <a class="visuellement-cache" href="#contenu">Aller au contenu</a>
  <EnTete sansMenu={sansMenu} />
  <main id="contenu"><slot /></main>
  <SuivezNous />
  <PiedDePage sansMenu={sansMenu} />
  <script>import '../scripts/site.js';</script>
</body>
</html>
